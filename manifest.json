{
  "id": "contacts",
  "contexts": ["household", "shared_space"],
  "name": "Contacts",
  "version": "1.1.0",
  "description": "Shared household address book — doctors, schools, neighbors, emergency contacts. Track birthdays and anniversaries too. Add manually or import from a .vcf file.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["contacts", "address book", "emergency", "family"],
  "data_access": {
    "reads": [],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": ["birthday", "anniversary"],
  "exports": ["contact_emails", "contact_dates"],
  "row_policies": {
    "contacts": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    }
  },
  "member_references": {
    "contacts": { "column": "created_by", "on_removed": "keep" }
  },
  "nav": { "label": "Contacts" },
  "resource_limits": { "max_db_bytes": 10485760 },
  "icon": "👥"
}
