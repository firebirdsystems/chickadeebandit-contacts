{
  "id": "contacts",
  "contexts": ["household", "shared_space"],
  "name": "Contacts",
  "version": "1.1.0",
  "description": "Shared household address book — doctors, schools, neighbors, emergency contacts. Track birthdays and anniversaries too. Add manually or import from a .vcf file.",
  "entrypoint": "index.html",
  "runtime": "static",
  "category": "general",
  "tags": ["contacts", "address book", "emergency", "family"],
  "data_access": {
    "reads": [],
    "writes": []
  },
  "permissions": {
    "default_audience": "everyone",
    "requires_approval": false
  },
  "storage": "db",
  "db_plaintext_columns": ["birthday", "anniversary"],
  "exports": ["contact_emails", "contact_dates"],
  "row_policies": {
    "contacts": {
      "kind": "owner_or_visibility",
      "member_column": "created_by",
      "visibility_column": "visibility",
      "everyone_values": ["everyone"]
    }
  },
  "member_references": {
    "contacts": { "column": "created_by", "on_removed": "keep" }
  },
  "publishes": ["contact.added"],
  "publish_acls": {
    "contact.added": { "require_role": "member" }
  },
  "automation_actions": {
    "add_contact": {
      "title": "Add a contact",
      "description": "File someone in the shared address book when another app's event carries a person - a new vendor, a sitter who took a shift, a neighbour who reported something.",
      "params": {
        "created_by": {
          "type": "member",
          "label": "Filed by",
          "required": true
        },
        "display_name": {
          "type": "text",
          "label": "Name",
          "required": true
        },
        "category": {
          "type": "text",
          "label": "Category",
          "default": ""
        },
        "phone": {
          "type": "text",
          "label": "Phone",
          "default": ""
        },
        "email": {
          "type": "text",
          "label": "Email",
          "default": ""
        },
        "notes": {
          "type": "text",
          "label": "Notes",
          "default": ""
        }
      },
      "dedupe": {
        "table": "contacts",
        "column": "source_event_id"
      },
      "steps": [
        {
          "op": "insert",
          "table": "contacts",
          "values": {
            "id": "$uuid",
            "display_name": ":display_name",
            "category": ":category",
            "phone": ":phone",
            "email": ":email",
            "notes": ":notes",
            "created_by": ":created_by",
            "created_at": "$now",
            "updated_at": "$now",
            "source_event_id": "$event_id"
          }
        }
      ]
    }
  },
  "nav": { "label": "Contacts" },
  "resource_limits": { "max_db_bytes": 10485760 },
  "icon": "👥"
}
